# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Owner ---
OWNER_TIMEZONE=Asia/Kolkata

# --- PostgreSQL ---
DB_NAME=linkedin_agent
DB_USER=linkedin_agent
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Memurai on Windows) / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- LinkedIn token encryption ---
# Fernet key(s), comma-separated, newest first. Never reuse DJANGO_SECRET_KEY.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# --- AI draft generation ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
AI_REVIEW_QUALITY_MIN=6
AI_REVIEW_AI_LIKE_MAX=4
AI_REVIEW_PROMOTIONAL_MAX=5
AI_REVIEW_REPETITION_MAX=5
# --- Later LinkedIn integration ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
LINKEDIN_API_VERSION=
