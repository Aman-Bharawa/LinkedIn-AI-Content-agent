# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Owner ---
OWNER_TIMEZONE=Asia/Kolkata

# --- PostgreSQL ---
DB_NAME=linkedin_agent
DB_USER=linkedin_agent
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Memurai on Windows) / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Later milestones (leave blank for now) ---
# Milestone 1: token encryption key(s), comma-separated, newest first. Not the Django SECRET_KEY.
TOKEN_ENCRYPTION_KEYS=
# Milestones 4-6
OPENAI_API_KEY=
OPENAI_MODEL=
# Milestones 9-10
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
LINKEDIN_API_VERSION=
